DATABASE_URL="postgresql://postgres:postgres@localhost:5432/company_brain?schema=public"

# Shared-password front door for the browser app.
COMPANY_BRAIN_APP_PASSWORD=""
COMPANY_BRAIN_SESSION_SECRET=""
COMPANY_BRAIN_API_TOKEN=""

# Phase 1 safety defaults.
LOCAL_INGESTION_ONLY=true
ALLOW_AUTONOMOUS_ACTIONS=false
ALLOW_EXTERNAL_WRITES=false

# Optional later, not required for Phase 1 local ingestion.
OPENAI_API_KEY=""
OPENAI_INBOX_MODEL="gpt-5.4-mini"

# Cheap Gmail sync testing: lower this locally to avoid scanning many threads.
GMAIL_SYNC_MAX_THREADS=5

# Zoho Books/Invoice integration. This is status/connect scaffold only until
# token storage and approval-gated invoice creation are enabled.
ZOHO_PRODUCT="invoice"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_ORGANIZATION_ID=""
ZOHO_REFRESH_TOKEN=""
# Optional for non-US Zoho data centers or explicit callback URLs.
ZOHO_ACCOUNTS_BASE_URL="https://accounts.zoho.com"
ZOHO_API_BASE_URL="https://www.zohoapis.com/invoice/v3"
ZOHO_OAUTH_REDIRECT_URI=""

# Google OAuth configuration
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""

# Encryption keys for token storage (32 bytes hex or random string)
GMAIL_TOKEN_ENCRYPTION_KEY=""
ZOHO_TOKEN_ENCRYPTION_KEY=""

# Cloudflare R2 / S3-compatible Object Storage
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Optional customization/tuning env vars
COMPANY_BRAIN_MAX_INBOX_ATTACHMENT_BYTES=""
FOLLOW_UP_THRESHOLD_DAYS=""
GMAIL_FOOTER=""
OPENAI_EXTRACTION_MODEL=""

OPENAI_MODEL=""
